<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinhu.oasis.tourism.mapper.ParkingSpaceMapper">

    <select id="selectAll" resultType="com.qinhu.oasis.tourism.entity.ParkingSpace">
        SELECT * FROM parking_space
        WHERE status != 0
        ORDER BY zone_code
    </select>

    <select id="selectById" resultType="com.qinhu.oasis.tourism.entity.ParkingSpace">
        SELECT * FROM parking_space WHERE id = #{id}
    </select>

</mapper>
